# ===================================================
# Bantu Jelasin - Konfigurasi Lingkungan (Environment)
# ===================================================

# Kunci API Google Gemini (Opsional).
# Jika dikosongkan, Bantu Jelasin otomatis menggunakan mesin Heuristik Cerdas
# Bahasa Indonesia bawaan tanpa biaya dan tanpa kuota!
GEMINI_API_KEY=

# Mode Provider AI alternatif jika diperlukan
AI_PROVIDER=gemini
